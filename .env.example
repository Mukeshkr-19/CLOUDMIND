# CloudMind runtime configuration.
# Copy this file to .env and keep real values out of Git.

# Optional: enables live Gemini incident/healthy dialogue generation.
# If blank, CloudMind uses built-in fallback dialogue scripts.
GEMINI_API_KEY=

# Optional: sends incident/remediation embeds to Discord.
DISCORD_WEBHOOK_URL=

# Required: protects InfraMirror's /whisper remediation webhook.
WHISPER_TOKEN=change_this_whisper_token_32chars_long_1234

# Required: Grafana admin credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# Remediation & Healing Safety Configuration:
# HEALING_ENABLED=false
# AIOPS_EXECUTION_MODE=recommend
# (Note: Automated container restart requires BOTH HEALING_ENABLED=true and AIOPS_EXECUTION_MODE=execute)

# Runtime tuning:
# CPU_SOFT_THRESHOLD=70
# CPU_HARD_THRESHOLD=85
# LAT_WARN_MS=250
# LAT_PAIN_MS=350
# HEALING_COOLDOWN_SEC=150

# AIOps intelligence configuration:
# AIOPS_ENABLED=true
# AIOPS_CONFIDENCE_THRESHOLD=0.75
# AIOPS_RECOVERY_TIMEOUT_SEC=45
# AIOPS_RECOVERY_POLL_SEC=3
# AIOPS_REQUIRED_HEALTHY_SAMPLES=2

# AIOps bounded work & threshold settings:
# AIOPS_MAX_WORKERS=5                # Valid range: 1 to 50
# AIOPS_QUEUE_CAPACITY=10            # Valid range: 0 to 500
# AIOPS_ERROR_RATIO_THRESHOLD=0.10   # Valid range: 0.0 to 1.0
# AIOPS_EXECUTION_GRACE_SEC=30       # Valid range: 0 to 300
