# =========================================================================
# CloudMind — Configuration Environment File
# =========================================================================
# Copy this file to '.env' and populate the values to activate live integrations.
#
#   cp .env.example .env
#
# =========================================================================

# -------------------------------------------------------------------------
# 1. AI Dialogue Engine Integration (Kimi / Gemini-2.5-Flash)
# -------------------------------------------------------------------------
# Retrieve a free API Key from Google AI Studio (https://aistudio.google.com/)
# This activates live, organic, character-driven dialogues during incidents.
# If left blank, the system automatically falls back to a randomized local engine.
GEMINI_API_KEY=

# -------------------------------------------------------------------------
# 2. Discord Webhook Notifications
# -------------------------------------------------------------------------
# Paste a Discord channel webhook URL here to receive beautiful SRE alerts
# and live dialogues right in your Discord server!
DISCORD_WEBHOOK_URL=

# -------------------------------------------------------------------------
# 3. SRE Healing Tuning
# -------------------------------------------------------------------------
HEALING_ENABLED=true
CPU_SOFT_THRESHOLD=70
CPU_HARD_THRESHOLD=85
LAT_WARN_MS=250
LAT_PAIN_MS=350
HEALING_COOLDOWN_SEC=150
