      "title": "Recovery Results and Duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "sum(rate(cloudmind_aiops_recovery_results_total[5m])) by (target, result)", "legendFormat": "{{target}} {{result}}", "refId": "A"},
        {"expr": "histogram_quantile(0.5, sum(rate(cloudmind_aiops_recovery_duration_seconds_bucket[5m])) by (le))", "legendFormat": "median duration", "refId": "B"}
      ]
    },
