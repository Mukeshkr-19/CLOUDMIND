      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "id": 9,
      "title": "AIOps Diagnosis Source and Fallbacks",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "sum(rate(cloudmind_aiops_diagnoses_total[5m])) by (source)", "legendFormat": "diagnosis {{source}}", "refId": "A"},
        {"expr": "sum(rate(cloudmind_aiops_model_fallbacks_total[5m])) by (reason_category)", "legendFormat": "fallback {{reason_category}}", "refId": "B"}
      ]
    },
    {
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
